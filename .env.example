# Copy to .env and fill in. Nothing here is required to run the anomaly
# endpoints; only natural language queries need a model.

# --- LLM provider: groq | ollama ---------------------------------------------
LLM_PROVIDER=groq

# Groq free tier: no credit card, 30 requests/min. Key from
# https://console.groq.com/keys
GROQ_API_KEY=

# Must support Structured Outputs strict mode. Verified 2026-09:
#   openai/gpt-oss-20b   (default; fastest strict-capable model)
#   openai/gpt-oss-120b  (stronger on unusual phrasing)
#   qwen/qwen3.8-27b
# Do NOT use llama-3.3-70b-versatile or llama-3.1-8b-instant: deprecated 2026-06-17.
GROQ_MODEL=openai/gpt-oss-20b

# --- Local alternative, no key and no network --------------------------------
# ollama serve && ollama pull qwen3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Data --------------------------------------------------------------------
# CSV_PATH=data/support_tickets.csv
# STRICT_INGEST=false

# Relative dates ("this month") resolve against the newest ticket by default,
# because the dataset is historical. Set to "system" for live data.
# REFERENCE_CLOCK=dataset_max

# --- Anomaly thresholds ------------------------------------------------------
# AGING_HOURS=24
# LOW_RATING_THRESHOLD=2
# OUTLIER_METHOD=iqr
# OUTLIER_GROUP_BY=priority
# IQR_MULTIPLIER=1.5
